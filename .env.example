# =============================================================================
# Content Generation Crew — Environment Template
# Copy this file to .env and fill in your API keys before running.
# =============================================================================

# Required: OpenAI (or compatible) API key used by CrewAI / LiteLLM
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: override the default model (CrewAI uses LiteLLM under the hood)
# Examples: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL_NAME=gpt-4o-mini

# Required for live web research (Serper.dev — https://serper.dev)
SERPER_API_KEY=your-serper-api-key

# Application settings
CONTENT_CREW_LOG_LEVEL=INFO
CONTENT_CREW_OUTPUT_DIR=outputs
CONTENT_CREW_VERBOSE=true

# Set to "true" to skip live LLM/tool calls and run with fixture data (CI / dry-run)
CONTENT_CREW_DRY_RUN=false
